# Copy to .env.local (git-ignored by create-next-app). Restart `npm run dev` after changes.

# Which network this build talks to: "testnet" (default) or "mainnet"
NEXT_PUBLIC_ARC_NETWORK=testnet

# Optional RPC overrides. Defaults are Arc's public endpoints.
# Arc's docs label the mainnet RPC "permissioned"; if browsers are blocked, set one you can use.
# NEXT_PUBLIC_ARC_TESTNET_RPC=
# NEXT_PUBLIC_ARC_MAINNET_RPC=

# First block to scan for events (never scan from 0). Everything NEXT_PUBLIC_ is visible in the browser.
# Mainnet: "block" in deployments/arcMainnet.json
# Testnet: block of your first createJob tx (tx 0xd2dae53716ea0da0fe2240ec33b44499d517a1cb4e3422b4545a32d7d4c0cddc)
NEXT_PUBLIC_ARC_MAINNET_DEPLOY_BLOCK=0
NEXT_PUBLIC_ARC_TESTNET_DEPLOY_BLOCK=0
    