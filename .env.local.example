# Copy this file to web/.env.local. Restart `npm run dev` after any change.

# Which network this build talks to: "testnet" (default) or "mainnet"
NEXT_PUBLIC_ARC_NETWORK=testnet

# Optional RPC overrides. Defaults are Arc's public endpoints (anonymous, CORS open, rate limited).
# If you see HTTP 429 errors, try one of Arc's other providers, for example:
#   https://rpc.blockdaemon.mainnet.arc.io
#   https://rpc.drpc.mainnet.arc.io
#   https://rpc.quicknode.mainnet.arc.io
# NEXT_PUBLIC_ARC_TESTNET_RPC=
# NEXT_PUBLIC_ARC_MAINNET_RPC=

# Optional: first block to scan for events. Built-in defaults already point just before the
# first job on each network, so leave these unset. Empty or 0 is ignored.
# NEXT_PUBLIC_ARC_MAINNET_DEPLOY_BLOCK=
# NEXT_PUBLIC_ARC_TESTNET_DEPLOY_BLOCK=
